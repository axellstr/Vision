---
import { Image } from 'astro:assets';
import '../styles/global.css';
import '../styles/about.css';
import '../components/navigation/Navbar.css';
import Navbar from '../components/navigation/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import '../components/layout/Footer.css';

// Import images
import designDirectorImage from '../assets/images/team/parisa.png';
import ualLogo from '../assets/images/team/ual.svg';
import giaLogo from '../assets/images/team/gia-logo.svg';
import mozImage from '../assets/images/team/moz.png';
import amalImage from '../assets/images/team/amal.webp';
import quotesSvg from '../assets/images/ui/quotes.svg';
import ScrollToTop from '../components/common/ScrollToTop.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>About Parisa Maghzian | Parisa London</title>
		<meta name="description" content="Discover the story behind Parisa London. British-Persian designer Parisa Maghzian creates luxury fine jewellery educated at Central Saint Martins and certified by GIA." />
		<link rel="canonical" href="https://parisajewellery.com/about" />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://parisajewellery.com/about" />
		<meta property="og:title" content="About Parisa Maghzian | Parisa London" />
		<meta property="og:description" content="Discover the story behind Parisa London. British-Persian designer Parisa Maghzian creates luxury fine jewellery." />
		<meta property="og:image" content="https://parisajewellery.com/products/hero.jpg" />
		<meta property="og:site_name" content="Parisa London" />
		<meta property="og:locale" content="en_GB" />
		
		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="About Parisa Maghzian | Parisa London" />
		<meta name="twitter:description" content="Discover the story behind Parisa London. British-Persian designer Parisa Maghzian creates luxury fine jewellery." />
		<meta name="twitter:image" content="https://parisajewellery.com/products/hero.jpg" />
		
		<meta name="robots" content="index, follow" />
		<meta name="theme-color" content="#0D1716" />
		
		<!-- Google Analytics 4 -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-2K38T0Y3XN"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-2K38T0Y3XN');
		</script>
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
	</head>
	<body>
		<Navbar/>
		<ScrollToTop />
		<div class="container">
			


			<!-- The Designer's Story -->
			<section class="designer-story">
				<div class="story-grid">
					<div class="story-content">
						<h2 class="section-title">About Parisa London</h2>
						<p class="story-text">
							Parisa Maghzian is a visionary British-Persian jewellery designer whose creations embody the perfect union of artistry, culture, and desire. Rooted in the richness of two worlds, her designs weave Eastern allure with Western poise, creating jewellery that feels both timeless and new.
						</p>
						<p class="story-text">
							Educated at the world-renowned Central Saint Martins College of Art and Design and certified by the prestigious Gemmological Institute of America (GIA), Parisa transforms rare gemstones and fine gold into wearable works of art.
						</p>
						<div class="story-logos">
							<Image src={ualLogo} alt="University of the Arts London" class="story-logo" />
							<Image src={giaLogo} alt="GIA - Gemological Institute of America" class="story-logo" />
						</div>
					</div>
					<div class="story-image">
						<Image 
							src={designDirectorImage} 
							alt="Parisa Maghzian, founder and designer"
							class="designer-img"
						/>
					</div>
				</div>
			</section>

			<!-- Recognition & Exhibitions -->
			<section class="recognition">
				<h2 class="section-title">Recognition & Exhibitions</h2>
				<p class="story-text">
					Her artistry has captivated collectors and connoisseurs worldwide. 
					From private commissions for international clients to exclusive collections showcased in Europe,
					the Middle East, and the United States, Parisa’s artistry has been showcased on some of the world’s
					 most prestigious stages, including a solo exhibition at Sotheby’s London. 
				</p>

				<!-- Recognition gallery with featured content -->
				<div class="recognition-gallery">
					<figure class="recognition-item">
						<Image src={mozImage} alt="Harvey Nichols London – Mozafarian concession" />
						<figcaption>Harvey Nichols London (Mozafarian)</figcaption>
					</figure>

					<div class="recognition-center-content">
						<h3 class="center-title">Celebrated Worldwide</h3>
						<p class="center-text">
							Parisa's designs grace the world's most prestigious locations, from luxury department stores to exclusive exhibitions. Each piece tells a story of cultural fusion and artistic excellence.
						</p>
						<div class="center-cta">
							<a href="/shop" class="cta-button">Explore Collections</a>
						</div>
					</div>

					<figure class="recognition-item">
						<Image class="recognition-img--amal" src={amalImage} alt="Amal Clooney wearing Parisa’s Citrine Diamond and Lemon Quartz Earrings" />
						<figcaption>Amal Clooney Appearance</figcaption>
					</figure>
				</div>
			</section>

			<!-- Follow-up and Closing merged -->
			<section class="designer-follow-up brand-expansion">
				<p class="story-text">
					Rooted in the richness of two worlds, her designs weave Eastern allure with Western poise, creating jewellery that feels both timeless and new, her designs transcend trends, fusing timeless elegance with modern sophistication. Each piece is meticulously handcrafted, defined by delicate craftsmanship and imbued with meaning—celebrating love, passion, and the stories that shape us.
				</p>
				<p class="story-text">
					Now expanding her brand across the Atlantic, Parisa introduces her evocative designs to the United States, continuing to enchant a global audience with jewellery that is more than an accessory— a timeless treasure to be cherished for generations.
				</p>
			</section>

			<!-- Brand Values Quote -->
			<section class="brand-values">
				<div class="quote-container">
					<Image src={quotesSvg} alt="Quote decoration" class="quote-decoration quote-left" />
					<p class="brand-quote">
						Ethically made, responsibly sourced — <span style="font-style: italic;">handcrafted in London.</span>
					</p>
					<Image src={quotesSvg} alt="Quote decoration" class="quote-decoration quote-right" />
				</div>
			</section>

		</div>
		<Footer />
		
		<script>
			// Intersection Observer for scroll animations
			const observerOptions = {
				threshold: 0.1,
				rootMargin: '0px 0px -50px 0px'
			};

			const observer = new IntersectionObserver((entries) => {
				entries.forEach(entry => {
					if (entry.isIntersecting) {
						entry.target.classList.add('animate');
					}
				});
			}, observerOptions);

			// Observe all elements that need animation
			document.addEventListener('DOMContentLoaded', () => {
				const elementsToAnimate = document.querySelectorAll(
					'.section-title, .story-content, .story-image, .story-text, .story-logos, ' +
					'.recognition-item, .recognition-center-content, .brand-expansion, .brand-values'
				);

				elementsToAnimate.forEach(el => observer.observe(el));
			});
		</script>
	</body>
</html>