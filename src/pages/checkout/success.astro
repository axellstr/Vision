---
import '../../styles/global.css';

// Get session ID from URL parameters for verification
const { searchParams } = Astro.url;
const sessionId = searchParams.get('session_id');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Order Confirmation - Parisa London</title>
  <meta name="description" content="Thank you for your order from Parisa London">
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  
  <!-- Google Analytics 4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-2K38T0Y3XN"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-2K38T0Y3XN');
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
</head>

<body>

  
  <main class="success-page">
    <div class="container">
      <div class="success-content">
        <!-- Success Icon -->
        <div class="success-icon">
          <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22,4 12,14.01 9,11.01"></polyline>
          </svg>
        </div>

        <!-- Success Message -->
        <h1>Order Confirmed!</h1>
        <p class="success-subtitle">Thank you for your purchase. Your order has been successfully processed.</p>

        <!-- Order Details -->
        <div class="order-info">
          <div class="info-card">
            <h2>What happens next?</h2>
            <div class="timeline">
              <div class="timeline-item">
                <div class="timeline-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                    <polyline points="3.27,6.96 12,12.01 20.73,6.96"></polyline>
                    <line x1="12" y1="22.08" x2="12" y2="12"></line>
                  </svg>
                </div>
                <div class="timeline-content">
                  <h3>Order Processing</h3>
                  <p>Your order is being prepared and will be packaged with care</p>
                </div>
              </div>
              
              <div class="timeline-item">
                <div class="timeline-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
                    <polyline points="14,2 14,8 20,8"></polyline>
                  </svg>
                </div>
                <div class="timeline-content">
                  <h3>Email Confirmation</h3>
                  <p>You'll receive an order confirmation email with tracking details</p>
                </div>
              </div>
              
              <div class="timeline-item">
                <div class="timeline-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                </div>
                <div class="timeline-content">
                  <h3>Shipping & Delivery</h3>
                  <p>Your jewellery will be shipped according to your selected delivery method</p>
                </div>
              </div>
            </div>
          </div>

          <div class="info-card">
            <h2>Need Help?</h2>
            <p>If you have any questions about your order, please don't hesitate to contact us.</p>
            <div class="contact-methods">
              <a href="/contact" class="contact-link">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                Contact Us
              </a>
              <a href="/shop" class="contact-link">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 3h2l.4 2M7 13h10l4-8H5.4m-2.4-5L1 1h1.5m5.5 11v6a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-6M9 19.5a.5.5 0 1 1 0 1 .5.5 0 0 1 0-1Zm7 0a.5.5 0 1 1 0 1 .5.5 0 0 1 0-1Z"></path>
                </svg>
                Continue Shopping
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>


  <script>
    // Clear cart after successful payment
    if (typeof localStorage !== 'undefined') {
      localStorage.removeItem('cart');
    }
    if (typeof sessionStorage !== 'undefined') {
      sessionStorage.removeItem('checkoutAppliedPromo');
    }

  </script>

  <style>
    .success-page {
     max-height: 100vh;
      padding: 3rem 0;
      background: var(--background);
    }

    .success-content {
      max-width: 800px;
      margin: 0 auto;
      text-align: center;
    }

    .success-icon {
      margin: 0 auto 2rem;
      width: 80px;
      height: 80px;
      color: #10b981;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .success-content h1 {
      font-size: 2.5rem;
      font-weight: 300;
      color: var(--primary);
      margin-bottom: 1rem;
    }

    .success-subtitle {
      font-size: 1.125rem;
      color: var(--text-dark);
      opacity: 0.8;
      margin-bottom: 3rem;
    }

    .order-info {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2rem;
      text-align: left;
    }

    @media (min-width: 768px) {
      .order-info {
        grid-template-columns: 1fr 1fr;
      }
    }

    .info-card {
      background: white;
      border: 1px solid #e5e5e5;
      padding: 2rem;
    }

    .info-card h2 {
      font-size: 1.25rem;
      color: var(--primary);
      margin-bottom: 1.5rem;
    }

    .timeline {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .timeline-item {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
    }

    .timeline-icon {
      width: 40px;
      height: 40px;
      background: rgba(54, 143, 139, 0.1);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--secondary);
      flex-shrink: 0;
    }

    .timeline-content h3 {
      font-size: 1rem;
      font-weight: 500;
      color: var(--primary);
      margin-bottom: 0.25rem;
    }

    .timeline-content p {
      font-size: 0.875rem;
      color: var(--text-dark);
      opacity: 0.8;
      line-height: 1.4;
    }

    .contact-methods {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-top: 1.5rem;
    }

    .contact-link {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.75rem 1rem;
      border: 1px solid #e5e5e5;
      background: white;
      color: var(--primary);
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .contact-link:hover {
      border-color: var(--secondary);
      background: rgba(54, 143, 139, 0.05);
    }

    @media (max-width: 640px) {
      .success-page {
        padding: 2rem 0;
      }

      .success-content h1 {
        font-size: 2rem;
      }

      .info-card {
        padding: 1.5rem;
      }

      .timeline-item {
        gap: 0.75rem;
      }

      .timeline-icon {
        width: 32px;
        height: 32px;
      }
    }
  </style>
</body>
</html>
