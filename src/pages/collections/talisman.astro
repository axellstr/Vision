---
import '../../styles/global.css';
import '../../components/navigation/Navbar.css';
import '../../components/layout/Footer.css';
import './_talisman.css';
import { Image } from 'astro:assets';
import Navbar from '../../components/navigation/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import ScrollToTop from '../../components/common/ScrollToTop.astro';
import { getAllTalismanProducts } from '../../data/products/talisman';

const talismanProducts = getAllTalismanProducts();
import heroImage from '../../assets/images/talisman/Talisman_0.jpg';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Talisman Calligraphy Collection | Parisa London</title>
    <meta name="description" content="Discover the Talisman Calligraphy collection — pieces inspired by ancient scripts featuring the art of Calligraphy spreading values of love, luck, and peace." />
    <link rel="canonical" href="https://parisajewellery.com/collections/talisman" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://parisajewellery.com/collections/talisman" />
    <meta property="og:title" content="Talisman Calligraphy Collection | Parisa London" />
    <meta property="og:description" content="Discover the Talisman Calligraphy collection — pieces inspired by ancient scripts crafted for modern elegance." />
    <meta property="og:image" content="https://parisajewellery.com/products/hero.jpg" />
    <meta property="og:site_name" content="Parisa London" />
    <meta property="og:locale" content="en_GB" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Talisman Calligraphy Collection | Parisa London" />
    <meta name="twitter:description" content="Discover the Talisman Calligraphy collection — pieces inspired by ancient scripts." />
    <meta name="twitter:image" content="https://parisajewellery.com/products/hero.jpg" />
    
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0D1716" />
    
    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-2K38T0Y3XN"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-2K38T0Y3XN');
    </script>
    
    <!-- DNS Prefetch & Preconnect for fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
    
    <script src="/cart-manager.js" is:inline></script>
  </head>
  <body>
    <Navbar />

    <main class="collection-page">
      <section class="collection-hero">
        <div class="collection-hero-content">
          <div class="hero-container">
            <div class="hero-image">
              <Image src={heroImage} alt="Talisman Calligraphy Collection" width={600} height={500} format="webp" quality={90} loading="eager" />
            </div>
            <div class="hero-text">
              <h1 class="hero-title">Talisman Calligraphy</h1>
              <div class="hero-description">
                <p>Inspired by culture, the Talisman Calligraphy Collection is based on modern pattern and incorporates the art of Calligraphy spreading values of love, luck, and peace.</p>
                <p>Since ancient times Talisman objects have been worn as jewels to bring harmony, good fortune and protect the wearer against the curse of the eye. The Evil Eye has Symbolism is almost every country in the world and every religion as a symbol of protection.</p>
                <p>Talisman collection is exquisite and captures the spirit of this energy with every piece, easy to wear and great to be given and gifted to loved ones on any occasions.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="collection-intro">
        <div class="container">

        </div>
      </section>

      <section class="collection-grid container">
        <div class="products-grid">
          {talismanProducts.map((product) => (
            <article class="product-card">
              <a href={`/shop/product/${product.id}`} class="product-link" aria-label={product.name}>
                <div class="product-image">
                  {typeof product.images.main === 'string' ? (
                    <img
                      src={product.images.main}
                      alt={product.name}
                      width="500"
                      height="500"
                      loading="lazy"
                      decoding="async"
                      sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
                    />
                  ) : (
                    <Image
                      src={product.images.main}
                      alt={product.name}
                      width={500}
                      height={500}
                      format="webp"
                      quality={90}
                      loading="lazy"
                    />
                  )}
                </div>
                <div class="product-info">
                  <h3 class="product-name">{product.name}</h3>
                  <p class="product-price">£{product.price.current.toLocaleString('en-GB')}</p>
                </div>
              </a>
            </article>
          ))}
        </div>
      </section>
    </main>

    <Footer />
    <ScrollToTop />
  </body>
</html>

