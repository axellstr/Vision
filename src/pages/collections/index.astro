---
import '../../styles/global.css';
import '../../components/navigation/Navbar.css';
import '../../components/layout/Footer.css';
import './_collections.css';
import { Image } from 'astro:assets';
import Navbar from '../../components/navigation/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import ScrollToTop from '../../components/common/ScrollToTop.astro';

// Collection cover images
import talismanImage from '../../assets/images/collections/talisman.png';
import kaleidoscopeImage from '../../assets/images/kaleidoscope/16.png';
import heritageImage from '../../assets/images/collections/heripage.png';
import foreverImage from '../../assets/images/forever/forever_parisa.png';
import bespokeImage from '../../assets/images/collections/dhero.png';

const collections = [
  { 
    slug: 'talisman', 
    name: 'Talisman', 
    image: talismanImage,
    description: 'Sacred symbols and protective charms crafted with spiritual intention and artistic precision.'
  },
  { 
    slug: 'kaleidoscope', 
    name: 'Kaleidoscope', 
    image: kaleidoscopeImage,
    description: 'Dynamic patterns and vibrant colors inspired by the ever-changing beauty of light and form.'
  },
  { 
    slug: 'heritage', 
    name: 'Heritage', 
    image: heritageImage,
    description: 'Timeless designs that honor traditional craftsmanship while embracing contemporary elegance.'
  },
  { 
    slug: 'forever', 
    name: 'Forever', 
    image: foreverImage,
    description: 'Symbols of eternal love and commitment, designed to be cherished through generations.'
  },
  { 
    slug: 'bespoke', 
    name: 'Bespoke', 
    image: bespokeImage,
    description: 'Custom creations tailored to your unique vision, where personal stories become wearable art.'
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Jewellery Collections | Parisa London</title>
    <meta name="description" content="Explore Parisa London's jewellery collections: Talisman, Heritage, Kaleidoscope, Forever, and Bespoke. Each collection tells a unique story through handcrafted fine jewellery." />
    <link rel="canonical" href="https://parisajewellery.com/collections" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://parisajewellery.com/collections" />
    <meta property="og:title" content="Jewellery Collections | Parisa London" />
    <meta property="og:description" content="Explore Parisa London's jewellery collections: Talisman, Heritage, Kaleidoscope, Forever, and Bespoke." />
    <meta property="og:image" content="https://parisajewellery.com/products/hero.jpg" />
    <meta property="og:site_name" content="Parisa London" />
    <meta property="og:locale" content="en_GB" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Jewellery Collections | Parisa London" />
    <meta name="twitter:description" content="Explore Parisa London's jewellery collections: Talisman, Heritage, Kaleidoscope, Forever, and Bespoke." />
    <meta name="twitter:image" content="https://parisajewellery.com/products/hero.jpg" />
    
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0D1716" />
    
    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-2K38T0Y3XN"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-2K38T0Y3XN');
    </script>
    
    <!-- DNS Prefetch & Preconnect for fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
    
    <script src="/cart-manager.js" is:inline></script>
  </head>
  <body>
    <Navbar />

    <main class="collections-page">

      <section class="collections-grid-section">
        <div class="container">
          <div class="collections-grid" role="list">
            {collections.map((c) => (
              <a href={`/collections/${c.slug}`} class="collection-card" role="listitem" aria-label={`${c.name} collection`}>
                <div class="collection-image">
                  <Image
                    src={c.image}
                    alt={`${c.name} Collection`}
                    width={400}
                    height={300}
                    format="webp"
                    quality={90}
                    loading="lazy"
                    decoding="async"
                    sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                    densities={[1, 1.5, 2]}
                  />
                </div>
                <div class="collection-meta">
                  <h3 class="collection-name">{c.name}</h3>
                  <p class="collection-description">{c.description}</p>
                  <span class="collection-cta">Explore Collection</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    </main>

    <Footer />
    <ScrollToTop />
  </body>
  </html>


