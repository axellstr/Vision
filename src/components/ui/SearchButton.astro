---
import { getAllProducts } from '../../data/products';
import { getImage } from 'astro:assets';

const allProducts = getAllProducts();
const searchIndex = await Promise.all(
  allProducts.map(async (p) => {
    const thumb = p?.images?.thumbnail;
    let thumbFallbackSrc = '';
    let thumbFallbackSrcset = '';
    let thumbWebpSrcset = '';
    let thumbAvifSrcset = '';
    let thumbWidth = 56;
    let thumbHeight = 56;
    try {
      if (thumb && typeof thumb !== 'string') {
        const [avif1x, avif2x, webp1x, webp2x, fallback1x, fallback2x] = await Promise.all([
          getImage({ src: thumb, width: 56, height: 56, format: 'avif' }),
          getImage({ src: thumb, width: 112, height: 112, format: 'avif' }),
          getImage({ src: thumb, width: 56, height: 56, format: 'webp' }),
          getImage({ src: thumb, width: 112, height: 112, format: 'webp' }),
          getImage({ src: thumb, width: 56, height: 56 }),
          getImage({ src: thumb, width: 112, height: 112 }),
        ]);
        thumbAvifSrcset = `${avif1x.src} 1x, ${avif2x.src} 2x`;
        thumbWebpSrcset = `${webp1x.src} 1x, ${webp2x.src} 2x`;
        thumbFallbackSrc = fallback1x.src;
        thumbFallbackSrcset = `${fallback1x.src} 1x, ${fallback2x.src} 2x`;
      } else if (typeof thumb === 'string') {
        // In TS data files, image imports are plain strings in dev. Build optimized URLs via on-demand endpoint.
        const enc = encodeURIComponent;
        const build = (href: string, fmt: string | undefined, w: number, h: number) => `/_image?href=${enc(href)}&w=${w}&h=${h}${fmt ? `&f=${fmt}` : ''}`;
        const base = thumb;
        const w1 = 56, h1 = 56, w2 = 112, h2 = 112;
        thumbAvifSrcset = `${build(base, 'avif', w1, h1)} 1x, ${build(base, 'avif', w2, h2)} 2x`;
        thumbWebpSrcset = `${build(base, 'webp', w1, h1)} 1x, ${build(base, 'webp', w2, h2)} 2x`;
        thumbFallbackSrc = build(base, '', w1, h1);
        thumbFallbackSrcset = `${build(base, '', w1, h1)} 1x, ${build(base, '', w2, h2)} 2x`;
      }
    } catch {}
    return {
      id: p.id,
      name: p.name,
      category: p.category,
      collection: p.collection,
      tags: p.tags || [],
      // Legacy fields (kept for safety)
      thumb: thumbFallbackSrc,
      thumbSrcset: thumbFallbackSrcset,
      // New optimized sources
      thumbAvifSrcset: thumbAvifSrcset,
      thumbWebpSrcset: thumbWebpSrcset,
      thumbFallbackSrc: thumbFallbackSrc,
      thumbFallbackSrcset: thumbFallbackSrcset,
      thumbWidth,
      thumbHeight
    };
  })
);
---

<style is:global>
  @import './SearchButton.css';
  
</style>

<div class="search-container">
  <button class="search-btn" id="search-btn" aria-label="Open search" aria-haspopup="listbox" aria-expanded="false" aria-controls="search-dropdown">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <path fill-rule="evenodd" clip-rule="evenodd" d="M10 1C5.02944 1 1 5.02944 1 10C1 14.9706 5.02944 19 10 19C12.125 19 14.078 18.2635 15.6177 17.0319L20.2929 21.7071C20.6834 22.0976 21.3166 22.0976 21.7071 21.7071C22.0976 21.3166 22.0976 20.6834 21.7071 20.2929L17.0319 15.6177C18.2635 14.078 19 12.125 19 10C19 5.02944 14.9706 1 10 1ZM3 10C3 6.13401 6.13401 3 10 3C13.866 3 17 6.13401 17 10C17 13.866 13.866 17 10 17C6.13401 17 3 13.866 3 10Z" fill="currentColor"/>
    </svg>
  </button>

  <div class="search-dropdown" id="search-dropdown" role="listbox" aria-label="Search results" hidden>
    <div class="search-input-wrap">
      <input id="search-input" class="search-input" type="search" placeholder="Search products..." autocomplete="off" aria-autocomplete="list" aria-controls="search-results" aria-expanded="false" />
    </div>
    <ul id="search-results" class="search-results" role="presentation"></ul>
    <div id="search-empty" class="search-empty">Start typing to search</div>
  </div>
  <script id="search-data" type="application/json">{JSON.stringify(searchIndex)}</script>
</div>

<script>
  // @ts-nocheck
  function initSearch() {
    const btn = document.getElementById('search-btn');
    const dropdown = document.getElementById('search-dropdown');
    const input = document.getElementById('search-input');
    const resultsEl = document.getElementById('search-results');
    const emptyEl = document.getElementById('search-empty');
    if (!btn || !dropdown || !input || !resultsEl || !emptyEl) return;

    let products = [];
    let isOpen = false;
    let currentIndex = -1;

    let originalParent = null;
    let placeholder = null;

    function portalDropdownToBody() {
      if (!dropdown || dropdown.classList.contains('search-portal')) return;
      originalParent = dropdown.parentElement;
      placeholder = document.createComment('search-dropdown-placeholder');
      originalParent?.insertBefore(placeholder, dropdown);
      dropdown.classList.add('search-portal');
      document.body.appendChild(dropdown);
    }

    function restoreDropdown() {
      if (!placeholder || !originalParent) return;
      dropdown.classList.remove('search-portal');
      originalParent.insertBefore(dropdown, placeholder);
      originalParent.removeChild(placeholder);
      placeholder = null;
      originalParent = null;
    }

    function shouldPortal() {
      return window.innerWidth <= 1024;
    }

    function setOpen(open) {
      isOpen = open;
      btn.setAttribute('aria-expanded', String(open));
      input.setAttribute('aria-expanded', String(open));
      if (open) {
        if (shouldPortal()) portalDropdownToBody();
        dropdown.hidden = false;
        requestAnimationFrame(() => input.focus());
      } else {
        dropdown.hidden = true;
        if (shouldPortal()) restoreDropdown();
        btn.focus();
      }
    }

    function renderResults(items) {
      resultsEl.innerHTML = '';
      currentIndex = -1;
      if (!items || items.length === 0) {
        emptyEl.textContent = input.value.trim() ? 'No items found' : 'Start typing to search';
        emptyEl.style.display = 'block';
        return;
      }
      emptyEl.style.display = 'none';
      const frag = document.createDocumentFragment();
      function buildOptimizedFromBase(baseSrc) {
        // If we don't have precomputed sources (server-side), synthesize via on-demand image endpoint
        // Only attempt for raster formats; keep SVGs as-is
        const isSvg = typeof baseSrc === 'string' && baseSrc.toLowerCase().endsWith('.svg');
        if (!baseSrc || isSvg) {
          return {
            avifSrcset: '',
            webpSrcset: '',
            fallbackSrc: baseSrc || '',
            fallbackSrcset: ''
          };
        }
        const enc = encodeURIComponent;
        const w1 = 56, h1 = 56, w2 = 112, h2 = 112;
        const build = (fmt, w, h) => `/_image?href=${enc(baseSrc)}&w=${w}&h=${h}${fmt ? `&f=${fmt}` : ''}`;
        return {
          avifSrcset: `${build('avif', w1, h1)} 1x, ${build('avif', w2, h2)} 2x`,
          webpSrcset: `${build('webp', w1, h1)} 1x, ${build('webp', w2, h2)} 2x`,
          fallbackSrc: build('', w1, h1),
          fallbackSrcset: `${build('', w1, h1)} 1x, ${build('', w2, h2)} 2x`
        };
      }

      items.forEach((p) => {
        const li = document.createElement('li');
        li.className = 'search-item';
        const a = document.createElement('a');
        a.href = `/shop/product/${p.id}`;
        a.className = 'search-item-link';
        a.setAttribute('role', 'option');
        a.setAttribute('aria-selected', 'false');

        // Build optimized <picture>
        const picture = document.createElement('picture');
        const sourceAvif = document.createElement('source');
        sourceAvif.type = 'image/avif';
        let avifSet = p.thumbAvifSrcset || '';
        let webpSet = p.thumbWebpSrcset || '';
        let fallbackSrc = p.thumbFallbackSrc || p.thumb || '';
        let fallbackSet = p.thumbFallbackSrcset || p.thumbSrcset || '';
        const isOptimized = typeof fallbackSrc === 'string' && fallbackSrc.indexOf('/_image') === 0;
        const isSvg = typeof fallbackSrc === 'string' && fallbackSrc.toLowerCase().endsWith('.svg');
        if (!avifSet || !webpSet || !fallbackSrc || (!isOptimized && !isSvg)) {
          const built = buildOptimizedFromBase(p.thumb || p.thumbFallbackSrc || '');
          avifSet = avifSet || built.avifSrcset;
          webpSet = webpSet || built.webpSrcset;
          fallbackSrc = fallbackSrc || built.fallbackSrc;
          fallbackSet = fallbackSet || built.fallbackSrcset;
        }
        if (avifSet) sourceAvif.srcset = avifSet;
        const sourceWebp = document.createElement('source');
        sourceWebp.type = 'image/webp';
        if (webpSet) sourceWebp.srcset = webpSet;
        const img = document.createElement('img');
        img.src = fallbackSrc || '';
        if (fallbackSet) img.srcset = fallbackSet;
        img.alt = p.name || '';
        img.width = p.thumbWidth || 56;
        img.height = p.thumbHeight || 56;
        img.loading = 'eager';
        img.decoding = 'async';
        img.className = 'search-item-image';
        picture.appendChild(sourceAvif);
        picture.appendChild(sourceWebp);
        picture.appendChild(img);

      const meta = document.createElement('div');
      meta.className = 'search-item-meta';

      const title = document.createElement('span');
      title.className = 'search-item-title';
      title.textContent = p.name || '';

      const sub = document.createElement('span');
      sub.className = 'search-item-subtitle';
      const cat = p.category || '';
      const col = p.collection || '';
      sub.textContent = col ? `${cat} · ${col}` : cat;

      meta.appendChild(title);
      meta.appendChild(sub);

      a.appendChild(picture);
      a.appendChild(meta);
        li.appendChild(a);
        frag.appendChild(li);
      });
      resultsEl.appendChild(frag);
    }

    function normalize(str) {
      return (str || '').toLowerCase();
    }

    function filterProducts(query) {
      const q = normalize(query);
      if (!q) return [];
      return products.filter((p) => {
        const inName = normalize(p.name).includes(q);
        const inTags = Array.isArray(p.tags) && p.tags.some(t => normalize(t).includes(q));
        const inCategory = normalize(p.category).includes(q);
        return inName || inTags || inCategory;
      }).slice(0, 8);
    }

    function ensureProductsLoaded() {
      if (products.length) return;
      const dataEl = document.getElementById('search-data');
      if (!dataEl) return;
      try {
        const data = JSON.parse(dataEl.textContent || '[]');
        products = Array.isArray(data) ? data : [];
      } catch {
        products = [];
      }
      // Fallback: if server index is missing/empty, build client index from data module
      if (!products || products.length === 0) {
        import('../../data/products').then((mod) => {
          try {
            const all = (mod.getAllProducts && mod.getAllProducts()) || [];
            products = all.map((p) => {
              const t = p?.images?.thumbnail;
              const thumb = typeof t === 'string' ? t : (t?.src || '');
              return { id: p.id, name: p.name, category: p.category, collection: p.collection, tags: p.tags || [], thumb };
            });
          } catch {}
        }).catch(() => {});
      }
    }

    function onOpen() {
      setOpen(true);
      ensureProductsLoaded();
      const items = filterProducts(input.value);
      renderResults(items);
    }

    function onClose() {
      setOpen(false);
    }

    function updateActive(indexDelta) {
      const links = resultsEl.querySelectorAll('.search-item-link');
      if (links.length === 0) return;
      const nextIndex = (currentIndex + indexDelta + links.length) % links.length;
      if (currentIndex >= 0) {
        links[currentIndex].setAttribute('aria-selected', 'false');
        links[currentIndex].classList.remove('active');
      }
      links[nextIndex].setAttribute('aria-selected', 'true');
      links[nextIndex].classList.add('active');
      links[nextIndex].scrollIntoView({ block: 'nearest' });
      currentIndex = nextIndex;
    }

    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      if (isOpen) onClose(); else onOpen();
    });

    input.addEventListener('input', () => {
      if (!products.length) ensureProductsLoaded();
      const items = filterProducts(input.value);
      renderResults(items);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        onClose();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        updateActive(1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        updateActive(-1);
      } else if (e.key === 'Enter') {
        const active = resultsEl.querySelector('.search-item-link.active');
        if (active) {
          active.click();
        }
      }
    });

    document.addEventListener('click', (e) => {
      if (!isOpen) return;
      if (!dropdown.contains(e.target) && !btn.contains(e.target)) {
        onClose();
      }
    });

    // Prevent dropdown from being occluded by body overflow on mobile/tablet
    const observer = new ResizeObserver(() => {
      const rect = btn.getBoundingClientRect();
      document.documentElement.style.setProperty('--navbar-bottom', `${rect.bottom}px`);
    });
    observer.observe(btn);

    window.addEventListener('resize', () => {
      if (!isOpen) return;
      // Re-evaluate portal on resize breakpoint change
      if (shouldPortal()) {
        portalDropdownToBody();
      } else {
        restoreDropdown();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) onClose();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSearch);
  } else {
    initSearch();
  }
</script>


