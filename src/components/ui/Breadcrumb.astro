---
export interface BreadcrumbItem {
  label: string;
  href?: string;
  current?: boolean;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav class="breadcrumb" aria-label="Breadcrumb navigation">
  <div class="container">
    <ol class="breadcrumb-list">
      {items.map((item, index) => (
        <li class="breadcrumb-item">
          {item.current ? (
            <span class="breadcrumb-current" aria-current="page">
              {item.label}
            </span>
          ) : (
            <a href={item.href} class="breadcrumb-link">
              {item.label}
            </a>
          )}
          {index < items.length - 1 && (
            <span class="breadcrumb-separator" aria-hidden="true">/</span>
          )}
        </li>
      ))}
    </ol>
  </div>
</nav>

<style>
  .breadcrumb {
    background: color-mix(in srgb, var(--primary) 2%, transparent 98%);
    border-bottom: 1px solid color-mix(in srgb, var(--primary) 8%, transparent 92%);
    padding: 1rem 0;
  }

  .container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.875rem;
    color: color-mix(in srgb, var(--text-dark) 70%, transparent 30%);
  }

  .breadcrumb-item {
    display: flex;
    align-items: center;
  }

  .breadcrumb-link {
    color: color-mix(in srgb, var(--text-dark) 70%, transparent 30%);
    text-decoration: none;
    transition: color 0.2s ease;
    padding: 0.25rem 0;
  }

  .breadcrumb-link:hover {
    color: var(--primary);
  }

  .breadcrumb-separator {
    margin: 0 0.75rem;
    color: color-mix(in srgb, var(--text-dark) 40%, transparent 60%);
    font-weight: 300;
  }

  .breadcrumb-current {
    color: var(--text-dark);
    font-weight: 500;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .container {
      padding: 0 1rem;
    }

    .breadcrumb-list {
      font-size: 0.8rem;
    }

    .breadcrumb-separator {
      margin: 0 0.5rem;
    }
  }

  @media (max-width: 480px) {
    .breadcrumb {
      padding: 0.75rem 0;
    }

    .breadcrumb-list {
      font-size: 0.75rem;
      flex-wrap: wrap;
      gap: 0.25rem 0;
    }

    .breadcrumb-separator {
      margin: 0 0.375rem;
    }
  }
</style>
