<!-- Cart Drawer (rendered outside navbar) -->
<CartDrawer />

<!-- Cart Thumbnail Generator (provides optimized images for cart items) -->
<CartThumbnailGenerator />

<script>
  // @ts-nocheck

  // Mobile menu functionality
  const hamburgerBtn = document.getElementById('hamburger-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileMenuClose = document.getElementById('mobile-menu-close');
  
  const navbarEl = document.querySelector('.navbar');
  let lastFocusedElement = null;
  const focusSelectors = 'a[href], button:not([disabled]), textarea, input[type="text"], input[type="search"], input[type="radio"], input[type="checkbox"], select, [tabindex]:not([tabindex="-1"])';
  
  // Add navbar-loaded class on page load to trigger animation
  if (navbarEl) {
    navbarEl.classList.add('navbar-loaded');
  }
  
  const updateNavbarVars = () => {
    if (!navbarEl) return;
    const rect = navbarEl.getBoundingClientRect();
    const height = navbarEl.offsetHeight;
    document.documentElement.style.setProperty('--navbar-bottom', `${rect.bottom}px`);
    document.documentElement.style.setProperty('--navbar-height', `${height}px`);
  };

  updateNavbarVars();
  window.addEventListener('resize', updateNavbarVars);
  window.addEventListener('scroll', updateNavbarVars, { passive: true });

  // Professional scroll-hide navbar implementation
  let lastScrollY = window.scrollY;
  let ticking = false;
  const SCROLL_THRESHOLD = 10; // Minimum scroll distance to trigger hide/show
  const SCROLL_UP_SHOW_THRESHOLD = 5; // Show navbar after scrolling up this many pixels

  function updateNavbarOnScroll() {
    const currentScrollY = window.scrollY;
    const scrollDifference = currentScrollY - lastScrollY;

    // Don't hide navbar if mobile menu or cart drawer is open
    const isMobileMenuOpen = document.body.classList.contains('mobile-menu-open');
    const isCartDrawerOpen = document.body.classList.contains('cart-drawer-open');
    
    if (isMobileMenuOpen || isCartDrawerOpen) {
      ticking = false;
      return;
    }

    // Add scrolled class for shadow effect
    if (currentScrollY > 50) {
      navbarEl.classList.add('navbar-scrolled');
    } else {
      navbarEl.classList.remove('navbar-scrolled');
    }

    // Don't hide navbar at the very top of the page
    if (currentScrollY < 100) {
      navbarEl.classList.remove('navbar-hidden');
      navbarEl.classList.add('navbar-visible');
      lastScrollY = currentScrollY;
      ticking = false;
      return;
    }

    // Scrolling down - hide navbar
    if (scrollDifference > SCROLL_THRESHOLD) {
      navbarEl.classList.add('navbar-hidden');
      navbarEl.classList.remove('navbar-visible');
    } 
    // Scrolling up - show navbar
    else if (scrollDifference < -SCROLL_UP_SHOW_THRESHOLD) {
      navbarEl.classList.remove('navbar-hidden');
      navbarEl.classList.add('navbar-visible');
    }

    lastScrollY = currentScrollY;
    ticking = false;
  }

  function requestScrollTick() {
    if (!ticking) {
      window.requestAnimationFrame(updateNavbarOnScroll);
      ticking = true;
    }
  }

  // Initialize navbar - animation will handle initial visibility
  // Add navbar-visible after animation completes (1.8s delay + 1.2s duration = 3.0s)
  if (navbarEl) {
    setTimeout(() => {
      navbarEl.classList.add('navbar-visible');
      // Re-enable transition for scroll behavior
      navbarEl.style.transition = 'transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease';
    }, 3000);
    window.addEventListener('scroll', requestScrollTick, { passive: true });
  }

  if (hamburgerBtn && mobileMenu) {
    function openMobileMenu() {
      lastFocusedElement = document.activeElement;
      mobileMenu.classList.add('active');
      document.body.classList.add('mobile-menu-open');
      hamburgerBtn.classList.add('is-active');
      hamburgerBtn.setAttribute('aria-expanded', 'true');
      hamburgerBtn.setAttribute('aria-label', 'Close menu');
      // Focus first focusable element in the menu
      const focusable = mobileMenu.querySelectorAll(focusSelectors);
      if (focusable.length > 0) {
        focusable[0].focus();
      } else {
        mobileMenu.focus();
      }
    }

    function closeMobileMenu() {
      mobileMenu.classList.remove('active');
      document.body.classList.remove('mobile-menu-open');
      hamburgerBtn.classList.remove('is-active');
      hamburgerBtn.setAttribute('aria-expanded', 'false');
      hamburgerBtn.setAttribute('aria-label', 'Open menu');
      if (lastFocusedElement && lastFocusedElement.focus) {
        lastFocusedElement.focus();
      } else {
        hamburgerBtn.focus();
      }
    }

    function toggleMobileMenu() {
      if (mobileMenu.classList.contains('active')) {
        closeMobileMenu();
      } else {
        openMobileMenu();
      }
    }

    // Click-only handling (mirror cart behavior)
    hamburgerBtn.addEventListener('click', toggleMobileMenu);

    if (mobileMenuClose) {
      mobileMenuClose.addEventListener('click', closeMobileMenu);
    }

    // Close mobile menu when clicking backdrop (outside panel)
    mobileMenu.addEventListener('click', (e) => {
      if (e.target === mobileMenu) {
        closeMobileMenu();
      }
    });

    // Focus trap inside the menu
    mobileMenu.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const focusable = Array.from(mobileMenu.querySelectorAll(focusSelectors)).filter((el) => !el.hasAttribute('disabled') && el.getAttribute('tabindex') !== '-1');
      if (focusable.length === 0) {
        e.preventDefault();
        return;
      }
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    // Close mobile menu on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileMenu.classList.contains('active')) {
        closeMobileMenu();
      }
    });
  }

  // Cart functionality using cart store
  function initCartFeature() {
    const cartBtn = document.getElementById('cart-btn');
    const cartCountEl = document.getElementById('cart-count');
    // Import cart functions (will be available globally)
    async function initCart() {
      try {
        // Prefer global manager to avoid multiple module instances in islands
        if (window.globalCartManager) {
          const state = window.globalCartManager.getCartState();
          if (cartCountEl) {
            cartCountEl.textContent = state.itemCount.toString();
            cartCountEl.style.display = state.itemCount > 0 ? 'inline-flex' : 'none';
          }
          window.globalCartManager.subscribe((s) => {
            const cc = document.getElementById('cart-count');
            if (!cc) return;
            cc.textContent = s.itemCount.toString();
            cc.style.display = s.itemCount > 0 ? 'inline-flex' : 'none';
          });
          if (cartBtn) {
            cartBtn.addEventListener('click', (e) => {
              e.preventDefault();
              e.stopPropagation();
              window.globalCartManager.toggleCartDrawer();
            });
          }
          return; // done
        }

        // Fallback to module store
        const { subscribeToCart, getCartState, toggleCartDrawer } = await import('../../data/cart');

        const initialState = getCartState();
        if (cartCountEl) {
          cartCountEl.textContent = initialState.itemCount.toString();
          cartCountEl.style.display = initialState.itemCount > 0 ? 'inline-flex' : 'none';
        }
        subscribeToCart((state) => {
          const cc = document.getElementById('cart-count');
          if (!cc) return;
          cc.textContent = state.itemCount.toString();
          cc.style.display = state.itemCount > 0 ? 'inline-flex' : 'none';
        });
        if (cartBtn) {
          cartBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            toggleCartDrawer();
          });
        }
      } catch (err) {
        console.error('Failed to initialize cart in navbar:', err);
      }
    }
    // Initialize cart functionality
    initCart();
  }

  // Ensure DOM is ready before initializing
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCartFeature);
  } else {
    initCartFeature();
  }

  // Fallback: listen for global cart update events to keep count in sync
  window.addEventListener('cart:updated', (e: any) => {
    try {
      const state = e?.detail;
      const cc = document.getElementById('cart-count');
      if (!state || !cc) return;
      cc.textContent = state.itemCount.toString();
      cc.style.display = state.itemCount > 0 ? 'inline-flex' : 'none';
    } catch {}
  });

  // Also respond to storage changes (another tab or different instance updates)
  window.addEventListener('storage', (evt: StorageEvent) => {
    if (evt.key === 'cart') {
      try {
        const data = evt.newValue ? JSON.parse(evt.newValue) : null;
        const cc = document.getElementById('cart-count');
        if (!data || !cc) return;
        const itemCount = data.itemCount ?? (data.items ? data.items.reduce((s: number, it: any) => s + (it.quantity || 0), 0) : 0);
        cc.textContent = String(itemCount);
        cc.style.display = itemCount > 0 ? 'inline-flex' : 'none';
      } catch {}
    }
  });

  // Professional dropdown navigation with delayed close and animations
  (function initDropdownNavigation() {
    const dropdowns = document.querySelectorAll('.nav-dropdown');
    const CLOSE_DELAY = 2000; // 2 seconds delay before closing
    const ANIMATION_DURATION = 400; // Time for closing animation to complete (0.3s animation + 0.1s buffer)
    
    dropdowns.forEach(dropdown => {
      let closeTimer = null;
      let animationTimer = null;
      const dropdownMenu = dropdown.querySelector('.dropdown-menu');
      const dropdownTrigger = dropdown.querySelector('.dropdown-trigger');
      
      if (!dropdownMenu || !dropdownTrigger) return;
      
      // Function to open dropdown
      function openDropdown() {
        // Clear any pending close timers
        if (closeTimer) {
          clearTimeout(closeTimer);
          closeTimer = null;
        }
        if (animationTimer) {
          clearTimeout(animationTimer);
          animationTimer = null;
        }
        
        // Remove closing state if present and add open state
        dropdown.classList.remove('dropdown-closing');
        dropdown.classList.add('dropdown-open');
      }
      
      // Function to close dropdown with animation
      function closeDropdown() {
        // Start closing animation
        dropdown.classList.remove('dropdown-open');
        dropdown.classList.add('dropdown-closing');
        
        // After animation completes, remove closing class
        animationTimer = setTimeout(() => {
          dropdown.classList.remove('dropdown-closing');
          animationTimer = null;
        }, ANIMATION_DURATION);
      }
      
      // Function to schedule dropdown close with delay
      function scheduleClose() {
        // Clear any existing timer
        if (closeTimer) {
          clearTimeout(closeTimer);
        }
        // Set new timer to close after delay
        closeTimer = setTimeout(() => {
          closeDropdown();
          closeTimer = null;
        }, CLOSE_DELAY);
      }
      
      // Only open dropdown when hovering the trigger link
      dropdownTrigger.addEventListener('mouseenter', openDropdown);
      
      // Schedule close when leaving the trigger
      dropdownTrigger.addEventListener('mouseleave', scheduleClose);
      
      // Keep dropdown open when hovering the dropdown menu
      dropdownMenu.addEventListener('mouseenter', openDropdown);
      
      // Schedule close when leaving the dropdown menu
      dropdownMenu.addEventListener('mouseleave', scheduleClose);
      
      // Optional: Close dropdown when clicking outside
      document.addEventListener('click', (e) => {
        if (!dropdown.contains(e.target)) {
          if (closeTimer) {
            clearTimeout(closeTimer);
            closeTimer = null;
          }
          closeDropdown();
        }
      });
      
      // Optional: Close dropdown on Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && dropdown.classList.contains('dropdown-open')) {
          if (closeTimer) {
            clearTimeout(closeTimer);
            closeTimer = null;
          }
          closeDropdown();
        }
      });
    });
  })();

</script>
