---
import { Image } from 'astro:assets';
import CartDrawer from '../ui/CartDrawer.astro';
import SearchButton from '../ui/SearchButton.astro';
import CartThumbnailGenerator from '../CartThumbnailGenerator.astro';

// Import collection images
import talismanImage from '../../assets/images/collections/talisman.png';
import kaleidoscopeImage from '../../assets/images/collections/khero.png';
import heritageImage from '../../assets/images/collections/heripage.png';
import foreverImage from '../../assets/images/forever/forever_parisa.png';
import bespokeImage from '../../assets/images/collections/dhero.png';
import Marquee from '../ui/Marquee.astro';
// Import logo
import logoDark from '../../assets/images/ui/Logo_dark.svg';
---

<nav class="navbar fade-in-three">
  <Marquee/>

  <div class="container">
    <div class="navbar-container">
      <!-- Left side - Hamburger (mobile) -->
      <button class="hamburger-btn" id="hamburger-btn" aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false" aria-haspopup="menu">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>

      <!-- Left side - Navigation Links -->
      <div class="nav-left">
        <div class="nav-links">
          <!-- Collections Dropdown -->
          <div class="nav-dropdown">
            <a href="/collections" class="nav-link dropdown-trigger">Collections</a>
            <div class="dropdown-menu">
              <div class="dropdown-container">
                <div class="collection-dropdown-item">
                  <a href="/collections/talisman" class="collection-dropdown-title">Talisman</a>
                  <div class="collection-dropdown-content">
                    <div class="collection-dropdown-image">
                      <Image
                        src={talismanImage}
                        alt="Talisman Collection"
                        class="collection-img"
                        width={150}
                        height={150}
                        format="webp"
                        quality={85}
                        loading="eager"
                        decoding="async"
                        densities={[1, 2]}
                      />
                    </div>
                    <div class="collection-subcategories">
                      <a href="/collections/talisman?category=rings" class="subcategory-link">Rings</a>
                      <a href="/collections/talisman?category=necklaces" class="subcategory-link">Necklaces</a>
                      <a href="/collections/talisman?category=bracelets" class="subcategory-link">Bracelets</a>
                      <a href="/collections/talisman?category=earrings" class="subcategory-link">Earrings</a>
                    </div>
                  </div>
                </div>
                <div class="collection-dropdown-item">
                  <a href="/collections/heritage" class="collection-dropdown-title">Heritage</a>
                  <div class="collection-dropdown-content">
                    <div class="collection-dropdown-image">
                      <Image
                        src={heritageImage}
                        alt="Heritage Collection"
                        class="collection-img"
                        width={150}
                        height={150}
                        format="webp"
                        quality={85}
                        loading="eager"
                        decoding="async"
                        densities={[1, 2]}
                      />
                    </div>
                    <div class="collection-subcategories">
                      <a href="/collections/heritage?category=rings" class="subcategory-link">Rings</a>
                      <a href="/collections/heritage?category=necklaces" class="subcategory-link">Necklaces</a>
                      <a href="/collections/heritage?category=bracelets" class="subcategory-link">Bracelets</a>
                      <a href="/collections/heritage?category=earrings" class="subcategory-link">Earrings</a>
                    </div>
                  </div>
                </div>
                <div class="collection-dropdown-item">
                  <a href="/collections/kaleidoscope" class="collection-dropdown-title">Kaleidoscope</a>
                  <div class="collection-dropdown-content">
                    <div class="collection-dropdown-image">
                      <Image
                        src={kaleidoscopeImage}
                        alt="Kaleidoscope Collection"
                        class="collection-img"
                        width={150}
                        height={150}
                        format="webp"
                        quality={85}
                        loading="eager"
                        decoding="async"
                        densities={[1, 2]}
                      />
                    </div>
                    <div class="collection-subcategories">
                      <a href="/collections/kaleidoscope?category=rings" class="subcategory-link">Rings</a>
                      <a href="/collections/kaleidoscope?category=necklaces" class="subcategory-link">Necklaces</a>
                      <a href="/collections/kaleidoscope?category=bracelets" class="subcategory-link">Bracelets</a>
                      <a href="/collections/kaleidoscope?category=earrings" class="subcategory-link">Earrings</a>
                    </div>
                  </div>
                </div>
                <div class="collection-dropdown-item">
                  <a href="/collections/forever" class="collection-dropdown-title">Forever</a>
                  <div class="collection-dropdown-content">
                    <div class="collection-dropdown-image">
                      <Image
                        src={foreverImage}
                        alt="Forever Collection"
                        class="collection-img"
                        width={150}
                        height={150}
                        format="webp"
                        quality={85}
                        loading="eager"
                        decoding="async"
                        densities={[1, 2]}
                      />
                    </div>
                    <div class="collection-subcategories">
                      <a href="/collections/forever?category=rings" class="subcategory-link">Rings</a>
                      <a href="/collections/forever?category=necklaces" class="subcategory-link">Necklaces</a>
                      <a href="/collections/forever?category=bracelets" class="subcategory-link">Bracelets</a>
                      <a href="/collections/forever?category=earrings" class="subcategory-link">Earrings</a>
                    </div>
                  </div>
                </div>
                <div class="collection-dropdown-item">
                  <a href="/collections/bespoke" class="collection-dropdown-title">Bespoke</a>
                  <div class="collection-dropdown-content">
                    <div class="collection-dropdown-image">
                      <Image
                        src={bespokeImage}
                        alt="Bespoke Collection"
                        class="collection-img"
                        width={150}
                        height={150}
                        format="webp"
                        quality={85}
                        loading="eager"
                        decoding="async"
                        densities={[1, 2]}
                      />
                    </div>
                    <div class="collection-subcategories">
                      <a href="/collections/bespoke?category=rings" class="subcategory-link">Rings</a>
                      <a href="/collections/bespoke?category=necklaces" class="subcategory-link">Necklaces</a>
                      <a href="/collections/bespoke?category=bracelets" class="subcategory-link">Bracelets</a>
                      <a href="/collections/bespoke?category=earrings" class="subcategory-link">Earrings</a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <a href="/shop" class="nav-link">Shop</a>
          <a href="/about" class="nav-link">The Brand</a>
        </div>
      </div>

      <!-- Center - Logo -->
      <div class="nav-center">
        <a href="/" class="logo-link">
          <img src={logoDark.src} alt="Parisa London" class="logo" />
        </a>
      </div>

      <!-- Right side - Search, Contact and Cart -->
      <div class="nav-right">
        <div class="nav-actions">
          <a href="/contact" class="contact-btn" aria-label="Contact us">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <path stroke="currentColor" stroke-width="2" d="M2 6a1.5 1.5 0 0 1 1.5-1.5h17A1.5 1.5 0 0 1 22 6v12a1.5 1.5 0 0 1-1.5 1.5h-17A1.5 1.5 0 0 1 2 18V6Z"/>
              <path stroke="currentColor" stroke-width="2" d="m2 5.5 9.045 7.463a1.5 1.5 0 0 0 1.91 0L22 5.5"/>
            </svg>
          </a>
          <SearchButton />

          <button class="cart-btn" id="cart-btn" aria-label="Open cart" aria-controls="cart-drawer" aria-expanded="false" aria-haspopup="dialog">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M6 7V5.77273C6 4.2263 6.644 2.75317 7.77399 1.67454C8.9024 0.597427 10.4233 0 12 0C13.5767 0 15.0976 0.597427 16.226 1.67454C17.356 2.75317 18 4.2263 18 5.77273V7H19C20.1046 7 21 7.89543 21 9V18C21 20.7614 18.7614 23 16 23H8C5.23858 23 3 20.7614 3 18V9C3 7.89543 3.89543 7 5 7H6ZM9.15494 3.12126C9.9019 2.40825 10.9245 2 12 2C13.0755 2 14.0981 2.40825 14.8451 3.12126C15.5904 3.83275 16 4.78754 16 5.77273V7H8V5.77273C8 4.78755 8.40957 3.83275 9.15494 3.12126ZM5 18V9H19V18C19 19.6569 17.6569 21 16 21H8C6.34315 21 5 19.6569 5 18Z" fill="currentColor" />
            </svg>
            <span class="cart-count" id="cart-count">0</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</nav>

<!-- Mobile Menu Overlay (rendered outside navbar to avoid transform stacking context) -->
