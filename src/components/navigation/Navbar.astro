                  <path d="M21.875 43.75H37.5V59.375H21.875V43.75ZM21.875 15.625H37.5V0H21.875V15.625ZM21.875 37.5H37.5V21.875H21.875V37.5ZM0 59.375H15.625V43.75H0V59.375ZM21.875 81.25H37.5V65.625H21.875V81.25ZM43.75 37.5H59.375V21.875H43.75V37.5ZM43.75 59.375H59.375V43.75H43.75V59.375ZM0 37.5H15.625V21.875H0V37.5ZM0 0V15.625H15.625V0H0ZM81.25 0H65.625V15.625H81.25V0ZM0 65.625V81.25H15.625V65.625H0ZM43.75 81.25H59.375V65.625H43.75V81.25ZM65.625 81.25H81.25V65.625H65.625V81.25ZM43.75 15.625H59.375V0H43.75V15.625ZM65.625 37.5H81.25V21.875H65.625V37.5ZM65.625 59.375H81.25V43.75H65.625V59.375Z" fill="currentColor"/>
