<!-- Swiper JS -->
<script>
    import Swiper from 'swiper';
    import { Grid, Navigation } from 'swiper/modules';
    import 'swiper/css';
    import 'swiper/css/grid';
    import 'swiper/css/navigation';

    // Initialize Swiper when DOM is loaded
    document.addEventListener('DOMContentLoaded', function() {
        const swiper = new Swiper('.gallery-swiper', {
            // Enable modules
            modules: [Grid, Navigation],
            
            // Navigation configuration
            navigation: {
                nextEl: '.gallery-carousel__nav-btn--right',
                prevEl: '.gallery-carousel__nav-btn--left',
            },
            
            // Responsive breakpoints
            breakpoints: {
                // Mobile: 2 slides
                320: {
                    slidesPerView: 2,
                    spaceBetween: 16,
                    grid: {
                        rows: 1,
                    },
                },
                // Tablet: 3 slides
                768: {
                    slidesPerView: 3,
                    spaceBetween: 20,
                    grid: {
                        rows: 1,
                    },
                },
                // Desktop: 4 slides
                1024: {
                    slidesPerView: 4,
                    spaceBetween: 24,
                    grid: {
                        rows: 1,
                    },
                },
            },
            
            // Performance optimizations
            watchSlidesProgress: true,
            preventClicks: false,
            preventClicksPropagation: false,
            
            // Touch and mouse events
            touchEventsTarget: 'container',
            shortSwipes: true,
            longSwipes: true,
            longSwipesRatio: 0.5,
            longSwipesMs: 300,
            
            // Auto height
            autoHeight: false,
            
            // Speed
            speed: 400,
            
            // Effect
            effect: 'slide',
        });

        // Function to update navigation button states
        function updateNavigationButtons() {
            const leftBtn = document.querySelector('.gallery-carousel__nav-btn--left') as HTMLButtonElement;
            const rightBtn = document.querySelector('.gallery-carousel__nav-btn--right') as HTMLButtonElement;
            
            if (leftBtn && rightBtn && swiper) {
                // Disable left button if at beginning
                if (swiper.isBeginning) {
                    leftBtn.disabled = true;
                    leftBtn.classList.add('gallery-carousel__nav-btn--disabled');
                } else {
                    leftBtn.disabled = false;
                    leftBtn.classList.remove('gallery-carousel__nav-btn--disabled');
                }
                
                // Disable right button if at end
                if (swiper.isEnd) {
                    rightBtn.disabled = true;
                    rightBtn.classList.add('gallery-carousel__nav-btn--disabled');
                } else {
                    rightBtn.disabled = false;
                    rightBtn.classList.remove('gallery-carousel__nav-btn--disabled');
                }
            }
        }

        // Update buttons on all relevant events
        swiper.on('init', updateNavigationButtons);
        swiper.on('slideChange', updateNavigationButtons);
        swiper.on('reachBeginning', updateNavigationButtons);
        swiper.on('reachEnd', updateNavigationButtons);
        swiper.on('resize', updateNavigationButtons);
        swiper.on('breakpoint', updateNavigationButtons);

        // Initial update after a short delay to ensure everything is rendered
        setTimeout(updateNavigationButtons, 100);
        
        // Also update on window resize
        window.addEventListener('resize', () => {
            setTimeout(updateNavigationButtons, 100);
        });
        
        // Scroll-triggered animation - move carousel one slide when it enters viewport
        let hasTriggeredScrollAnimation = false;

        const observerOptions = {
            threshold: 0.3, // Trigger when 30% of the carousel is visible
            rootMargin: '0px 0px -50px 0px' // Trigger slightly before fully entering viewport
        };

        const carouselObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting && swiper && !hasTriggeredScrollAnimation) {
                    // Mark as triggered to prevent multiple animations
                    hasTriggeredScrollAnimation = true;

                    // Slide to next position after a short delay for smooth effect
                    setTimeout(() => {
                        if (swiper && !swiper.isEnd) {
                            swiper.slideNext();
                        }
                    }, 300);

                    // Disconnect observer after first trigger
                    carouselObserver.disconnect();
                }
            });
        }, observerOptions);

        // Observe the carousel container
        const carouselElement = document.querySelector('.gallery-carousel');
        if (carouselElement) {
            carouselObserver.observe(carouselElement);
        }

        // Quick view functionality - Product ID mapping
        const productIdMap = {
            0: 'talisman-001', // Talisman Calligraphy Ring (talisman1)
            1: 'talisman-005', // Talisman Necklace (talisman7)
            2: 'talisman-002', // Talisman Ring (talisman2 - yellow and white gold)
            3: 'talisman-006', // Talisman Earrings (talisman5 - two-tone gold with diamonds)
            4: 'talisman-002', // Talisman Ring (talisman3 - yellow and white gold)
            5: 'talisman-003', // Talisman Ring (talisman4 - white gold with gemstones)
            6: 'talisman-007'  // Talisman Earrings (talisman6 - yellow gold with rubies)
        };

        const quickViewButtons = document.querySelectorAll('.gallery-carousel__quick-view-btn');
        quickViewButtons.forEach((button, index) => {
            button.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();

                // Get product ID from mapping
                const productId = productIdMap[index as keyof typeof productIdMap];

                if (productId) {
                    // Navigate to product page
                    window.location.href = `/shop/product/${productId}`;
                }
            });
        });
    });
</script>


