---
import { Image } from 'astro:assets';
import finalImage from '../../assets/images/ui/oner.png';
import productFirst from '../../assets/images/ui/onerr.png';
import productThird from '../../assets/images/ui/onerrr.png';
import './Hero.css';
---

<section class="hero">
  <div class="hero-container">
    <div class="hero-image-box">
      <Image 
        src={finalImage} 
        alt="Parisa London luxury jewelry" 
        class="hero-image"
        loading="eager"
        fetchpriority="high"
        quality={85}
        widths={[768, 1024, 1440, 1920]}
        sizes="(max-width: 768px) 100vw, 50vw"
        decoding="async"
      />
    </div>
    <div class="hero-text-box">
      <div class="hero-content-wrapper">
        <div class="hero-products">
          <a href="/shop/product/kaleidoscope-021" class="product-card">
            <Image 
              src={productThird} 
              alt="Kaleidoscope Emerald Tennis Necklace" 
              class="product-image"
              loading="eager"
              fetchpriority="high"
              quality={85}
              widths={[200, 300, 400]}
              sizes="(max-width: 768px) 160px, (max-width: 1024px) 220px, 300px"
              decoding="async"
            />
          </a>
          <a href="/shop/product/kaleidoscope-021" class="product-card">
            <Image 
              src={productFirst} 
              alt="Kaleidoscope Emerald Tennis Necklace - Detail View" 
              class="product-image"
              loading="eager"
              fetchpriority="high"
              quality={85}
              widths={[200, 300, 400]}
              sizes="(max-width: 768px) 160px, (max-width: 1024px) 220px, 300px"
              decoding="async"
            />
          </a>
        </div>
        <div class="hero-title">
          Ethically made, responsibly sourced
          <span class="hero-title-italic">— handcrafted in London.</span>
        </div>
        <div class="hero-buttons">
          <a href="/shop" class="cta-button">Explore Collections</a>
          <a href="/about" class="cta-button cta-square" aria-label="Our Story">
            <svg width="24" height="24" viewBox="0 0 66 53" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M7.584 52.032C5.344 52.032 3.68 51.712 2.592 51.072C1.504 50.368 0.799997 49.6 0.479997 48.768C0.16 47.936 0 47.296 0 46.848C0 46.016 0.287997 45.312 0.863997 44.736C1.44 44.16 2.24 43.872 3.264 43.872C3.776 43.872 4.256 44.032 4.704 44.352C5.088 44.608 5.28 45.024 5.28 45.6C5.28 46.24 5.056 46.72 4.608 47.04C4.16 47.296 3.648 47.424 3.072 47.424C2.624 47.424 2.24 47.392 1.92 47.328C1.6 47.2 1.44 47.136 1.44 47.136C1.44 47.968 1.856 48.832 2.688 49.728C3.52 50.56 4.928 50.976 6.912 50.976C9.85598 50.976 12.544 50.144 14.976 48.48C17.408 46.752 19.712 44.544 21.888 41.856C24.064 39.168 26.208 36.288 28.32 33.216C30.432 30.144 32.64 27.2 34.944 24.384C38.016 20.608 41.152 17.088 44.352 13.824C47.552 10.496 50.816 7.64801 54.144 5.28C57.472 2.84801 60.864 1.15201 64.32 0.192005C64.832 0.064001 65.12 0.160002 65.184 0.480005C65.248 0.800005 65.024 1.024 64.512 1.152C61.76 1.92 59.072 3.392 56.448 5.56801C53.824 7.74401 51.232 10.4 48.672 13.536C46.176 16.608 43.648 19.904 41.088 23.424C38.592 26.88 36.032 30.304 33.408 33.696C30.848 37.088 28.192 40.16 25.44 42.912C22.688 45.664 19.84 47.872 16.896 49.536C13.952 51.2 10.848 52.032 7.584 52.032ZM41.568 31.008C37.792 31.008 34.848 30.496 32.736 29.472C30.624 28.448 29.568 27.072 29.568 25.344C29.568 24.448 29.856 23.744 30.432 23.232C31.008 22.656 31.648 22.272 32.352 22.08C33.12 21.824 33.728 21.696 34.176 21.696C34.56 21.696 34.752 21.824 34.752 22.08C34.752 22.272 34.592 22.4 34.272 22.464C33.44 22.592 32.672 23.008 31.968 23.712C31.328 24.352 31.008 24.96 31.008 25.536C31.008 26.368 31.808 27.328 33.408 28.416C35.072 29.504 37.632 30.048 41.088 30.048C42.816 30.048 44.8 29.664 47.04 28.896C49.28 28.064 51.424 26.848 53.472 25.248C55.584 23.584 57.312 21.568 58.656 19.2C60 16.768 60.672 13.952 60.672 10.752C60.672 7.168 59.072 4.64 55.872 3.168C52.736 1.632 48.416 0.864005 42.912 0.864005C38.368 0.864005 34.048 1.536 29.952 2.88C25.856 4.224 22.208 5.952 19.008 8.064C15.872 10.176 13.376 12.448 11.52 14.88C9.7