            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Smooth hero animations on every page load
  function startHeroAnimation(hero: Element) {
    // Force reflow to ensure initial state is applied
    void (hero as HTMLElement).offsetHeight;
    
    // Use requestAnimationFrame for smooth animation start
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        hero.classList.add('hero-animate');
      });
    });
    
    // Clean up will-change after animations complete (longest animation is 1s + 0.6s delay)
    setTimeout(() => {
      const elements = hero.querySelectorAll('.hero-image, .product-card, .hero-title, .hero-buttons');
      elements.forEach(el => {
        (el as HTMLElement).style.willChange = 'auto';
      });
    }, 1800);
  }
  
  function initHeroAnimations() {
    const hero = document.querySelector('.hero');
    if (!hero) return;
    
    // Get the main hero image (first priority for LCP)
    const heroImage = hero.querySelector('.hero-image') as HTMLImageElement;
    
    if (!heroImage) {
      // No hero image, start animation immediately
      startHeroAnimation(hero);
      return;
    }
    
    // Check if image is already loaded and decoded
    if (heroImage.complete && heroImage.naturalHeight !== 0) {
      // Image already in cache or loaded - decode it if needed, then animate
      if ('decode' in heroImage) {
        heroImage.decode()
          .then(() => startHeroAnimation(hero))
          .catch(() => startHeroAnimation(hero)); // Start anyway on error
      } else {
        startHeroAnimation(hero);
      }
    } else {
      // Image not loaded yet - wait for it
      let hasStarted = false;
      
      const handleImageReady = () => {
        if (hasStarted) return;
        hasStarted = true;
        
        // Decode the image for smooth rendering
        if ('decode' in heroImage) {
          heroImage.decode()
            .then(() => startHeroAnimation(hero))
            .catch(() => startHeroAnimation(hero)); // Start anyway on error
        } else {
          startHeroAnimation(hero);
        }
      };
      
      // Listen for load event
      heroImage.addEventListener('load', handleImageReady, { once: true });
      
      // Also listen for error (don't block animation forever)
      heroImage.addEventListener('error', () => {
        if (!hasStarted) {
          hasStarted = true;
          startHeroAnimation(hero);
        }
      }, { once: true });
      
      // Safety timeout: start animation after 1 second max
      setTimeout(() => {
        if (!hasStarted) {
          hasStarted = true;
          startHeroAnimation(hero);
        }
      }, 1000);
    }
  }
  
  // Start animations as soon as DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroAnimations);
  } else {
    // DOM already loaded
    initHeroAnimations();
  }
  
  // Re-trigger animations on page show (e.g., back/forward navigation)
  window.addEventListener('pageshow', (event) => {
    // Check if page was restored from bfcache
    if (event.persisted) {
      const hero = document.querySelector('.hero');
      if (hero) {
        // Remove animation class
        hero.classList.remove('hero-animate');
        void (hero as HTMLElement).offsetHeight; // Force reflow
        
        // Image is already loaded from cache, so start immediately
        startHeroAnimation(hero);
      }
    }
  });
</script>
