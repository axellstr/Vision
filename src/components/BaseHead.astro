---
/**
 * BaseHead Component
 * 
 * Provides all essential head elements for SEO, social sharing, 
 * Google Analytics, and JSON-LD structured data.
 * 
 * Usage:
 * <BaseHead 
 *   title="Page Title" 
 *   description="Page description"
 *   image="/og-image.jpg"
 *   type="website"
 * />
 */

export interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article' | 'product';
  noindex?: boolean;
  canonicalUrl?: string;
  // Product-specific props for JSON-LD
  product?: {
    name: string;
    price: number;
    currency?: string;
    image: string;
    sku?: string;
    description?: string;
    collection?: string;
    inStock?: boolean;
  };
}

const { 
  title, 
  description, 
  image = '/og-image.jpg',
  type = 'website',
  noindex = false,
  canonicalUrl,
  product
} = Astro.props;

const siteUrl = 'https://parisajewellery.com';
const fullUrl = canonicalUrl || new URL(Astro.url.pathname, siteUrl).toString();
const fullImageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;

// Google Analytics Measurement ID (set in Vercel env vars)
const gaId = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID || '';

// Organization JSON-LD (shown on all pages)
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Parisa London",
  "url": siteUrl,
  "logo": `${siteUrl}/favicon.svg`,
  "description": "Luxury fine jewellery featuring handcrafted 18K gold pieces with rare Persian turquoise and gemstones.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "London",
    "addressCountry": "GB"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "email": "parisa@parisajewellery.com",
    "contactType": "customer service"
  },
  "sameAs": [
    "https://www.instagram.com/parisalondon/"
  ]
};

// Product JSON-LD (only for product pages)
const productSchema = product ? {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": product.name,
  "description": product.description || description,
  "image": product.image.startsWith('http') ? product.image : `${siteUrl}${product.image}`,
  "sku": product.sku,
  "brand": {
    "@type": "Brand",
    "name": "Parisa London"
  },
  "offers": {
    "@type": "Offer",
    "url": fullUrl,
    "priceCurrency": product.currency || "GBP",
    "price": product.price,
    "availability": product.inStock !== false 
      ? "https://schema.org/InStock" 
      : "https://schema.org/OutOfStock",
    "seller": {
      "@type": "Organization",
      "name": "Parisa London"
    }
  }
} : null;

// WebSite JSON-LD (for homepage)
const websiteSchema = Astro.url.pathname === '/' ? {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Parisa London",
  "url": siteUrl,
  "description": "Luxury fine jewellery featuring handcrafted 18K gold pieces with rare Persian turquoise and gemstones.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": `${siteUrl}/shop?q={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
} : null;
---

<!-- Primary Meta Tags -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="Parisa London" />
<meta name="theme-color" content="#0D1716" />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
<link rel="canonical" href={fullUrl} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={fullUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="Parisa London" />
<meta property="og:locale" content="en_GB" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={fullUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImageUrl} />

<!-- Preconnect for performance -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet" />

<!-- Google Analytics 4 -->
{gaId && (
  <>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaId, {
        page_title: document.title,
        page_location: window.location.href
      });
    </script>
  </>
)}

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

{websiteSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
)}

{productSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
)}

