---
import { Image } from 'astro:assets';
import type { Product } from '../../data/types';
import type { ImageMetadata } from 'astro';

export interface Props {
  product: Product;
  variantImagesMap?: Record<string, ImageMetadata> | null;
}

const { product, variantImagesMap } = Astro.props;

// Create gallery array combining main image and gallery images
const mainImage = product.images.main;
const galleryImages = product.images.gallery || [];

// Ensure we have exactly 3 images (main + 2 more, with placeholders if needed)
const allImages: (string | ImageMetadata | null)[] = [mainImage, ...galleryImages.slice(0, 2)];
while (allImages.length < 3) {
  allImages.push(null); // null represents placeholder
}
---

<div class="product-gallery">
  <div class="gallery-main">
    {/* Display all gallery images (hidden by default except first) */}
    {allImages.map((img, index) => (
      <div 
        class={`gallery-image-wrapper ${index === 0 ? 'active' : ''}`}
        data-index={index}
      >
        {img ? (
          typeof img === 'string' ? (
            <img 
              src={img}
              alt={`${product.name} - Image ${index + 1}`}
              class="main-image"
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
            />
          ) : (
            <Image 
              src={img}
              alt={`${product.name} - Image ${index + 1}`}
              class="main-image"
              width={600}
              height={600}
              format="webp"
              quality={90}
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
              sizes="(max-width: 768px) 100vw, 50vw"
              densities={[1, 1.5, 2]}
            />
          )
        ) : (
          <div class="placeholder-image">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <circle cx="8.5" cy="8.5" r="1.5"/>
              <polyline points="21,15 16,10 5,21"/>
            </svg>
          </div>
        )}
      </div>
    ))}
    
    {product.badges.isNew && (
      <span class="product-badge new">New</span>
    )}
    {product.badges.isBestseller && (
      <span class="product-badge bestseller">Bestseller</span>
    )}
    {product.badges.isLimitedEdition && (
      <span class="product-badge limited">Limited Edition</span>
    )}
  </div>
  
  {/* Thumbnail Navigation - Hidden for initial necklace (image changes with variant selection) */}
  {product.id !== 'forever-initial-necklace' && (
    <div class="gallery-thumbnails">
      {allImages.map((img, index) => (
        <button 
          class={`thumbnail ${index === 0 ? 'active' : ''}`}
          data-index={index}
          aria-label={`View image ${index + 1}`}
        >
          {img ? (
            typeof img === 'string' ? (
              <img 
                src={img}
                alt={`Thumbnail ${index + 1}`}
                loading="lazy"
              />
            ) : (
              <Image 
                src={img}
                alt={`Thumbnail ${index + 1}`}
                width={200}
                height={200}
                format="webp"
                quality={95}
                loading="lazy"
                decoding="async"
                densities={[1, 2]}
              />
            )
          ) : (
            <div class="placeholder-thumbnail">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21,15 16,10 5,21"/>
              </svg>
            </div>
          )}
        </button>
      ))}
    </div>
  )}
</div>

<script>
  // Gallery thumbnail navigation
  const thumbnails = document.querySelectorAll('.thumbnail');
  const imageWrappers = document.querySelectorAll('.gallery-image-wrapper');

  thumbnails.forEach((thumbnail) => {
    thumbnail.addEventListener('click', function(this: HTMLElement) {
      const index = this.getAttribute('data-index');
      
      // Remove active class from all thumbnails and images
      thumbnails.forEach(t => t.classList.remove('active'));
      imageWrappers.forEach(w => w.classList.remove('active'));
      
      // Add active class to clicked thumbnail and corresponding image
      this.classList.add('active');
      const targetImage = document.querySelector(`.gallery-image-wrapper[data-index="${index}"]`);
      if (targetImage) {
        targetImage.classList.add('active');
      }
    });
  });

  // Keyboard navigation
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    const activeIndex = parseInt(document.querySelector('.thumbnail.active')?.getAttribute('data-index') || '0');
    
    if (e.key === 'ArrowRight') {
      const nextIndex = (activeIndex + 1) % thumbnails.length;
      (thumbnails[nextIndex] as HTMLElement)?.click();
    } else if (e.key === 'ArrowLeft') {
      const prevIndex = (activeIndex - 1 + thumbnails.length) % thumbnails.length;
      (thumbnails[prevIndex] as HTMLElement)?.click();
    }
  });
</script>


<style>
  /* Product Gallery */
  .product-gallery {
    position: static;
    top: var(--spacing-2xl);
    height: fit-content;
  }

  .gallery-main {
    position: relative;
    margin-bottom: var(--spacing-lg);
    aspect-ratio: 1;
    overflow: hidden;
    background: #f5f5f5;
    border: 1px solid #e0e0e0;
  }

  .gallery-image-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s ease;
  }

  .gallery-image-wrapper.active {
    opacity: 1;
    visibility: visible;
  }

  .main-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Placeholder Images */
  .placeholder-image,
  .placeholder-thumbnail {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #d3d3d3;
    color: #999;
  }

  .placeholder-image {
    min-height: 400px;
  }

  /* Thumbnail Navigation */
  .gallery-thumbnails {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-md);
    margin-top: var(--spacing-lg);
    width: 100%;
  }

  /* Match thumbnail container width with main image on desktop */
  @media (min-width: 1025px) {
    .gallery-thumbnails {
      width: 80%;
      margin-left: auto;
      margin-right: auto;
    }
  }

  .thumbnail {
    position: relative;
    aspect-ratio: 1;
    border: 1px solid transparent;
    background: #f5f5f5;
    cursor: pointer;
    overflow: hidden;
    transition: border-color 0.3s ease;
    padding: 0;
  }

  .thumbnail.active {
    border-color: #999;
  }

  .thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .placeholder-thumbnail {
    min-height: 80px;
  }

  /* Product Badges */
  .product-badge {
    position: absolute;
    top: var(--spacing-lg);
    right: var(--spacing-lg);
    padding: var(--spacing-sm) var(--spacing-md);
    font-size: var(--font-size-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    z-index: 10;
  }

  .product-badge.new {
    background: var(--primary);
    color: var(--surface-white);
  }

  .product-badge.bestseller {
    border: 1px solid var(--primary);
    color: var(--text-dark);
    background: white;
  }

  .product-badge.limited {
    background: var(--error);
    color: var(--surface-white);
  }

  /* Responsive Design */
  @media (min-width: 1025px) {
    .gallery-main {
      width: 80%;
      height: 80%;
      margin: 0 auto var(--spacing-lg) auto;
    }
  }

  @media (max-width: 1024px) {
    .product-gallery {
      position: static;
    }
    
    .gallery-thumbnails {
      width: 100%;
    }
  }

  @media (max-width: 768px) {
    .gallery-thumbnails {
      gap: var(--spacing-sm);
    }
  }

  @media (max-width: 480px) {
    .product-badge {
      top: var(--spacing-md);
      right: var(--spacing-md);
      font-size: 10px;
      padding: 4px var(--spacing-sm);
    }

    .gallery-thumbnails {
      gap: 8px;
    }

    .placeholder-image {
      min-height: 300px;
    }

    .placeholder-thumbnail {
      min-height: 60px;
    }
  }
</style>
