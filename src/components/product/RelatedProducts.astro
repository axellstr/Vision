---
import { Image } from 'astro:assets';
import type { Product } from '../../data/types';

export interface Props {
  products: Product[];
}

const { products } = Astro.props;
---

{products.length > 0 && (
  <section class="related-products">
    <h2 class="related-title">You May Also Like</h2>
    <div class="related-grid">
      {products.map(relatedProduct => (
        <article class="related-product-card">
          <a href={`/shop/product/${relatedProduct.id}`} class="related-product-link">
            <div class="related-product-image">
              {typeof relatedProduct.images.thumbnail === 'string' ? (
                <img
                  src={relatedProduct.images.thumbnail}
                  alt={relatedProduct.name}
                  loading="lazy"
                  decoding="async"
                  sizes="(max-width: 768px) 50vw, (max-width: 1200px) 33vw, 25vw"
                />
              ) : (
                <Image
                  src={relatedProduct.images.thumbnail}
                  alt={relatedProduct.name}
                  width={300}
                  height={300}
                  format="webp"
                  quality={90}
                  loading="lazy"
                  decoding="async"
                  sizes="(max-width: 768px) 50vw, (max-width: 1200px) 33vw, 25vw"
                  densities={[1, 1.5, 2]}
                />
              )}
            </div>
            <div class="related-product-info">
              <h3 class="related-product-name">{relatedProduct.name}</h3>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>
)}

<style>
  /* Related Products */
  .related-products {
    border-top: 1px solid var(--surface-border);
    padding-top: var(--spacing-3xl);
  }

  .related-title {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-medium);
    text-align: left;
    margin: 0 0 var(--spacing-3xl) 0;
    color: var(--text-dark);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--spacing-lg);
  }

  .related-product-card {
    transition: var(--transition-normal);
    overflow: hidden;
  }


  .related-product-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .related-product-image {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--surface-light);
    margin-bottom: var(--spacing-lg);
    border: 1px solid var(--surface-border);
  }

  .related-product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition-slow);
  }

  .related-product-card:hover .related-product-image img {
    transform: scale(1.05);
  }


  .related-product-info {
    text-align: left;
    padding: var(--spacing-lg);
  }

  .related-product-name {
    font-size: var(--font-size-base);
    font-weight: var(--font-medium);
    margin: 0 0 var(--spacing-xs) 0;
    color: var(--text-dark);
    line-height: 1.4;
    min-height: 2.5rem;
    display: flex;
    align-items: center;
  }


  /* Responsive Design */
  @media (max-width: 1200px) {
    .related-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--spacing-lg);
    }
  }

  @media (max-width: 1023px) {
    .related-products {
      padding-top: var(--spacing-2xl);
    }

    .related-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--spacing-lg);
    }
  }

  @media (max-width: 768px) {
    .related-title {
      font-size: var(--font-size-lg);
      margin-bottom: var(--spacing-2xl);
    }

    .related-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-lg);
    }

    .related-product-info {
      text-align: center;
    }

    .related-product-name {
      font-size: var(--font-size-sm);
    }
  }

  @media (max-width: 480px) {
    .related-product-info {
      padding: var(--spacing-md);
    }
  }

  /* Laptops: make cards smaller as well */
  @media (min-width: 1024px) {
    .related-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Larger desktops: increase columns to reduce card size */
  @media (min-width: 1280px) {
    .related-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 1600px) {
    .related-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }
</style>
