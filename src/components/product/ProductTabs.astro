---
import type { Product } from '../../data/types';

export interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<div class="product-details">
  <div class="details-tabs">
    <button class="tab-btn active" data-tab="description">Description</button>
    <button class="tab-btn" data-tab="specifications">Specifications</button>
  </div>

  <div class="tab-content">
    <div class="tab-pane active" id="description">
      <div class="description-content">
        <h3>About This Piece</h3>
        <p>{product.description.long}</p>
        
        <h4>The Talisman Collection</h4>
        <p>Each piece in our Talisman collection is more than jewelry—it's a connection to ancient wisdom and modern artistry. Inspired by protective symbols and flowing calligraphy, these pieces carry meaning that transcends mere decoration.</p>
      </div>
    </div>

    <div class="tab-pane" id="specifications">
      <div class="specifications-grid">
        <div class="spec-item">
          <span class="spec-label">Metal Type:</span>
          <span class="spec-value">{product.specifications.metalType}</span>
        </div>
        <div class="spec-item">
          <span class="spec-label">Metal Color:</span>
          <span class="spec-value">{product.specifications.metalColor}</span>
        </div>
        {product.specifications.stoneType && (
          <div class="spec-item">
            <span class="spec-label">Stone Type:</span>
            <span class="spec-value">{product.specifications.stoneType}</span>
          </div>
        )}
      </div>
    </div>
  </div>
</div>

<script>
  // Tabs functionality
  const tabBtns = document.querySelectorAll('.tab-btn');
  const tabPanes = document.querySelectorAll('.tab-pane');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', function(this: HTMLElement) {
      const tabId = this.getAttribute('data-tab');
      
      // Update active tab
      tabBtns.forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      
      // Update active pane
      tabPanes.forEach(pane => pane.classList.remove('active'));
      const targetPane = tabId ? document.getElementById(tabId) : null;
      if (targetPane) {
        targetPane.classList.add('active');
      }
    });
  });
</script>

<style>
  /* Product Details Tabs */
  .product-details {
    border-top: 1px solid var(--surface-border);
    padding-top: var(--spacing-3xl);
    margin-bottom: var(--spacing-4xl);
    width: 100%;
  }

  .details-tabs {
    display: flex;
    border-bottom: 1px solid var(--surface-border);
    margin-bottom: var(--spacing-3xl);
    gap: 0;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .details-tabs::-webkit-scrollbar {
    display: none;
  }

  .tab-btn {
    background: none;
    border: none;
    padding: var(--spacing-lg) var(--spacing-xl);
    font-size: var(--font-size-sm);
    font-weight: var(--font-semibold);
    color: var(--text-light);
    cursor: pointer;
    transition: var(--transition-normal);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    position: relative;
    white-space: nowrap;
    flex-shrink: 0;
    min-width: fit-content;
  }

  .tab-btn:hover {
    color: var(--text-dark);
  }

  .tab-btn.active {
    color: var(--primary);
    border-bottom: 1px solid var(--primary);
  }

  .tab-pane {
    display: none;
  }

  .tab-pane.active {
    display: block;
  }

  .description-content h3,
  .description-content h4 {
    color: var(--text-dark);
    margin: 0 0 var(--spacing-xl) 0;
  }

  .description-content h3 {
    font-size: var(--font-size-xl);
    font-weight: var(--font-semibold);
    margin-bottom: var(--spacing-lg);
  }

  .description-content h4 {
    font-size: var(--font-size-lg);
    font-weight: var(--font-semibold);
    margin-top: var(--spacing-3xl);
    margin-bottom: var(--spacing-lg);
  }

  .description-content p {
    line-height: 1.8;
    color: var(--text-light);
    margin-bottom: var(--spacing-xl);
    width: 100%;
  }

  .specifications-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
    gap: var(--spacing-lg);
    width: 100%;
  }

  .spec-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-lg) var(--spacing-xl);
    background: var(--surface-white);
    border: 1px solid var(--surface-border);
    transition: var(--transition-normal);
  }

  .spec-label {
    font-weight: var(--font-semibold);
    color: var(--text-dark);
    font-size: var(--font-size-sm);
  }

  .spec-value {
    color: var(--text-light);
    font-weight: var(--font-medium);
    text-align: right;
  }


  /* Responsive Design */
  @media (max-width: 1024px) {
    .specifications-grid {
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    }
  }

  @media (max-width: 768px) {
    .product-details {
      padding-top: var(--spacing-2xl);
      margin-bottom: var(--spacing-3xl);
    }

    .details-tabs {
      margin-bottom: var(--spacing-2xl);
      padding-bottom: var(--spacing-sm);
    }

    .tab-btn {
      padding: var(--spacing-md) var(--spacing-lg);
      font-size: var(--font-size-lg);
    }

    .specifications-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }

    .spec-item {
      padding: var(--spacing-md) var(--spacing-lg);
    }

    .description-content h3 {
      font-size: var(--font-size-lg);
      margin-bottom: var(--spacing-md);
    }

    .description-content h4 {
      font-size: var(--font-size-base);
      margin-top: var(--spacing-2xl);
      margin-bottom: var(--spacing-md);
    }

    .description-content p {
      margin-bottom: var(--spacing-lg);
    }
  }

  @media (max-width: 480px) {
    .product-details {
      padding-top: var(--spacing-xl);
    }

    .details-tabs {
      margin-bottom: var(--spacing-xl);
    }

    .tab-btn {
      padding: var(--spacing-sm) var(--spacing-md);
      font-size: var(--font-size-sm);
    }

    .spec-item {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--spacing-xs);
      padding: var(--spacing-sm) var(--spacing-md);
    }

    .spec-value {
      text-align: left;
      font-size: var(--font-size-sm);
    }

    .spec-label {
      font-size: var(--font-size-xs);
    }

    .description-content h3 {
      font-size: var(--font-size-base);
    }

    .description-content h4 {
      font-size: var(--font-size-sm);
    }
  }
</style>
