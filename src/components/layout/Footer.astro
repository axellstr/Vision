---
// Import SVG assets
import logoLight from '../../assets/images/ui/Logo_light.svg';
import visaLogo from '../../assets/images/ui/payment/visa.svg';
import mastercardLogo from '../../assets/images/ui/payment/mastercard.svg';
import amexLogo from '../../assets/images/ui/payment/amex.svg';
import appleLogo from '../../assets/images/ui/payment/apple.svg';
import googlePayLogo from '../../assets/images/ui/payment/googlepay.svg';
import stripeLogo from '../../assets/images/ui/payment/stripe.svg';
import TermsModal from '../ui/TermsModal.astro';
import PrivacyModal from '../ui/PrivacyModal.astro';
---

<footer class="site-footer fade-in-three" aria-label="Site footer">
	<!-- Main footer -->
	<section class="footer-main" aria-label="Footer navigation">
		<div class="container footer-main__container">
			<div class="footer-brand">
				<a href="/" class="footer-brand__logo" aria-label="Parisa London home">
					<img src={logoLight.src} alt="Parisa London" />
				</a>
				<p class="footer-brand__desc">Luxury fine jewellery featuring handcrafted 18K gold pieces with rare Persian turquoise and gemstones.</p>
			</div>

			<div class="footer-content">
				<nav class="footer-links" aria-label="Footer links">
					<div class="footer-col">
						<h4 class="footer-col__title">Navigation</h4>
					<ul class="footer-col__list">
						<li><a href="/">Home</a></li>
						<li><a href="/collections">Collections</a></li>
						<li><a href="/about">About</a></li>
						<li><a href="/contact">Contact</a></li>
					</ul>
					</div>
					<div class="footer-col">
						<h4 class="footer-col__title">Support</h4>
						<ul class="footer-col__list">
							<li><a href="/contact">Help Center</a></li>
							<li><a href="/contact">Shipping Info</a></li>
							<li><a href="/contact">Returns</a></li>
						</ul>
					</div>
				</nav>

				<div class="footer-newsletter">
					<h4 class="newsletter-title">Subscribe to our newsletter</h4>
					<p class="newsletter-desc">Stay updated with our latest collections and exclusive offers</p>
					<form class="newsletter-form" aria-label="Newsletter subscription">
						<div class="newsletter-input-group">
							<input
								type="email"
								placeholder="Enter your email address"
								class="newsletter-input"
								required
								aria-label="Email address"
							/>
							<button type="submit" class="newsletter-button" aria-label="Subscribe to newsletter">
								Subscribe
							</button>
						</div>
					</form>
					<ul class="footer-social" aria-label="Social links">
						<li><a href="https://www.instagram.com/parisalondon/" target="_blank" rel="noopener noreferrer" aria-label="Follow us on Instagram" class="footer-social__link">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
						</a></li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- Copyright bar -->
	<div class="footer-bottom">
		<div class="container footer-bottom__container">
			<div class="footer-legal">
				<p class="footer-copy">© <span id="copyright-year">2025</span> Parisa London. All rights reserved.</p>
				<div class="footer-legal-links">
					<a href="#" data-modal="terms-modal" class="footer-legal-link">Terms of Service</a>
					<span class="footer-legal-separator">•</span>
					<a href="#" data-modal="privacy-modal" class="footer-legal-link">Privacy Policy</a>
				</div>
			</div>
			<div class="payment-methods" aria-label="Payment method logos">
				<img src={visaLogo.src} alt="Visa" class="payment-logo" />
				<img src={mastercardLogo.src} alt="Mastercard" class="payment-logo" />
				<img src={amexLogo.src} alt="American Express" class="payment-logo" />
				<img src={appleLogo.src} alt="Apple Pay" class="payment-logo" />
				<img src={googlePayLogo.src} alt="Google Pay" class="payment-logo" />
				<img src={stripeLogo.src} alt="Stripe" class="payment-logo" />
			</div>
		</div>
	</div>

	<TermsModal />
	<PrivacyModal />

	<script>
		document.addEventListener('DOMContentLoaded', function() {
			// Dynamic copyright year
			const copyrightYear = document.getElementById('copyright-year');
			if (copyrightYear) {
				copyrightYear.textContent = new Date().getFullYear().toString();
			}

			// Newsletter form handling
			const newsletterForm = document.querySelector('.newsletter-form');
			const newsletterButton = document.querySelector('.newsletter-button') as HTMLButtonElement;
			const newsletterInput = document.querySelector('.newsletter-input') as HTMLInputElement;

			if (newsletterForm && newsletterButton && newsletterInput) {
				newsletterForm.addEventListener('submit', async function(e) {
					e.preventDefault();
					
					const email = newsletterInput.value.trim();
					if (!email) return;

					// Show loading state
					newsletterButton.disabled = true;
					newsletterButton.textContent = 'Subscribing...';

					// For now, simulate subscription (replace with actual API call when ready)
					// TODO: Implement actual newsletter API integration
					await new Promise(resolve => setTimeout(resolve, 800));

					// Show success state
					newsletterInput.disabled = true;
					newsletterInput.value = 'Thank you for subscribing!';
					newsletterButton.textContent = 'Subscribed ✓';
					newsletterButton.style.background = 'color-mix(in srgb, var(--footer-fg) 8%, transparent 92%)';
					newsletterButton.style.borderColor = 'color-mix(in srgb, var(--footer-fg) 15%, transparent 85%)';
				});
			}

			// Setup modal links
			const modalLinks = document.querySelectorAll('[data-modal]');
			modalLinks.forEach(link => {
				link.addEventListener('click', (e) => {
					e.preventDefault();
					const modalId = link.getAttribute('data-modal');
					if (!modalId) return;
					const modal = document.getElementById(modalId);
					if (modal) {
						modal.classList.add('is-active');
						document.body.style.overflow = 'hidden';
					}
				});
			});
		});
	</script>
</footer> 